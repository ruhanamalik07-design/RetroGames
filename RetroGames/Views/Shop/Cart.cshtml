@model IReadOnlyList<RetroGames.Models.CartLine>

@{
    ViewData["Title"] = "Cart";
}

<h1>Your cart</h1>
@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <td>@line.Name</td>
                    <td>@line.UnitPrice.ToString("C")</td>
                    <td>@line.Quantity</td>
                    <td>@line.Total.ToString("C")</td>
                    <td>
                        <form asp-action="RemoveFromCart" method="post">
                            <input type="hidden" name="productId" value="@line.ProductId" />
                            <button type="submit" class="btn btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p><strong>Total: @Model.Sum(line => line.Total).ToString("C")</strong></p>
}
<a asp-action="Index">Continue shopping</a>