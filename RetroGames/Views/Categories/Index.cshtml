@model IEnumerable<RetroGames.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Pick a very cool category to browse our store</h1>

@if (Model != null && Model.Any())
{
    <ul>
        @foreach (var category in Model)
        {
            <li>
                <a asp-controller="Categories"
                   asp-action="Browse"
                   asp-route-categoryName="@category.Name">
                    @category.Name
                </a>
            </li>
        }
    </ul>
}
else
{
    <p>No categories available.</p>
}
